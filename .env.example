# ==============================================================================
# Ambrosio — Backend API Core & Regras de Negócio (CNC-Gestão)
# NUNCA insira credenciais reais neste arquivo. Copie para .env e ajuste localmente.
# ==============================================================================

NODE_ENV=development
PORT=3333

# Conexão com o PostgreSQL 17 (Banco unificado db_gestao, schema ambrosio)
DATABASE_URL="postgresql://ambrosio:[REDACTED]@localhost:5432/db_gestao?schema=ambrosio"
DB_SCHEMA=ambrosio

# JWT Secret compartilhado com o serviço São Pedro
JWT_SECRET="[REDACTED_SHARED_JWT_SECRET]"

# Serviço de Identidade São Pedro
SAO_PEDRO_API_URL="http://127.0.0.1:8000"
SAO_PEDRO_API_USER="ambrosio-service"
SAO_PEDRO_API_PASS="[REDACTED_SERVICE_PASSWORD]"

# Serviço de Envio de E-mails (Resend)
RESEND_API_KEY="re_[REDACTED_API_KEY]"

# ElasticSearch 8 (Busca textual e agregação)
ELASTICSEARCH_URL="http://127.0.0.1:9200"
ELK_ENABLED=false
ELK_LOG_FILE=./infra/runtime-logs/ambrosio.log

# CORS autorizado
CORS_ORIGIN="http://localhost:3000,https://cncbrasil2.cn.org.br"
